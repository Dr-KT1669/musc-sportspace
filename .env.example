DATABASE_URL="postgresql://sportspace:sportspace@127.0.0.1:5432/sportspace"
DATABASE_POOL_SIZE=20
DATABASE_POOL_TIMEOUT=15
JWT_SECRET="dev-only-change-me-sportspace"
PORT=43124
NODE_ENV=development

# Slot hold while the winner types the OTP. Resending the code does not extend this.
HOLD_SECONDS=90
OTP_MAX_ATTEMPTS=5
BOOKING_USER_LIMIT=6
BOOKING_IP_LIMIT=2000

BOOKING_WINDOW_DAYS=14
MIN_LEAD_MINUTES=30
CANCEL_LEAD_MINUTES=120
MAIL_FROM="MUSC SportSpace <no-reply@sportspace.sc.mahidol.ac.th>"

# Real email: set SMTP_HOST to send OTP through an SMTP server.
# Leave SMTP_HOST empty to use the dev mailbox (console + /dev-mail).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=

# Set to 1 when the site is served over HTTPS.
COOKIE_SECURE=0
