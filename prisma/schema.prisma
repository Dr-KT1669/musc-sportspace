generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String              @id @default(cuid())
  studentId    String              @unique
  name         String
  email        String              @unique
  passwordHash String
  phone        String
  department   String
  role         String
  coinBalance  Int                 @default(0)
  createdAt    DateTime            @default(now())
  bookings     Booking[]
  walletTx     WalletTransaction[]
}

model Facility {
  id              String    @id @default(cuid())
  slug            String    @unique
  type            String
  nameTh          String
  nameEn          String
  description     String
  location        String
  openTime        String
  closeTime       String
  slotMinutes     Int       @default(60)
  maxHours        Int       @default(2)
  capacity        Int
  lightsAvailable Boolean   @default(true)
  lightCoinCost   Int       @default(15)
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  bookings        Booking[]
  locks           SlotLock[]
  closures        Closure[]
}

model Closure {
  id         String   @id @default(cuid())
  facilityId String
  startDate  String
  endDate    String
  reason     String
  createdAt  DateTime @default(now())
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, startDate, endDate])
}

model Equipment {
  id           String          @id @default(cuid())
  slug         String          @unique
  nameTh       String
  nameEn       String
  totalQty     Int
  availableQty Int
  loans        EquipmentLoan[]
}

model Booking {
  id           String            @id @default(cuid())
  userId       String
  facilityId   String
  date         String
  startTime    String
  endTime      String
  purpose      String
  activityName String            @default("")
  lightsOn     Boolean           @default(false)
  lightCost    Int               @default(0)
  notes        String            @default("")
  status       String
  idempotencyKey String?
  checkInCode  String            @unique
  qrToken      String            @unique
  checkedInAt  DateTime?
  cancelledAt  DateTime?
  confirmedAt  DateTime?
  createdAt    DateTime          @default(now())
  user         User              @relation(fields: [userId], references: [id])
  facility     Facility          @relation(fields: [facilityId], references: [id])
  teammates    Teammate[]
  loans        EquipmentLoan[]
  locks        SlotLock[]
  otp          OtpCode?

  @@unique([userId, idempotencyKey])
  @@index([userId, date])
  @@index([date, status])
  @@index([facilityId, date])
}

/// One row per occupied hour. The unique key is what makes double-booking impossible.
model SlotLock {
  id         String   @id @default(cuid())
  facilityId String
  date       String
  startTime  String
  bookingId  String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([facilityId, date, startTime])
}

model Teammate {
  id         String  @id @default(cuid())
  bookingId  String
  name       String
  email      String  @default("")
  phone      String  @default("")
  department String  @default("")
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model EquipmentLoan {
  id          String    @id @default(cuid())
  bookingId   String
  equipmentId String
  qty         Int
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
}

model OtpCode {
  id        String   @id @default(cuid())
  bookingId String   @unique
  codeHash  String
  salt      String
  expiresAt DateTime
  attempts  Int      @default(0)
  sends     Int      @default(1)
  consumed  Boolean  @default(false)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model WalletTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  bookingId String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
